{
  "name": "pulsed",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@semantic-release/commit-analyzer": "^6.3.3",
    "@semantic-release/exec": "^3.3.8",
    "@semantic-release/gitlab": "^6.2.2",
    "@semantic-release/release-notes-generator": "^9.0.3",
    "esbuild": "0.28.2",
    "nuxt": "^3.15.1",
    "semantic-release": "^15.14.0",
    "typescript": "^5.9.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "^3.3.9"
  },
  "scripts": {
    "build:pages": "npm run build:ui && node scripts/build-pages.mjs",
    "typecheck:pages": "node scripts/typecheck-pages.mjs",
    "build:ui": "node scripts/build-branding.mjs && node scripts/check-versytl-vendor.mjs && tsc -p frontend/tsconfig.json && esbuild frontend/main.ts --bundle --format=esm --target=es2022 --outfile=templates/assets/ui/dashboard.js --log-level=warning",
    "test:ui": "npm run build:ui && node --test frontend/test/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "release": "semantic-release"
  }
}
