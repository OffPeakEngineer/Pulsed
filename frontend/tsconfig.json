{
  "compilerOptions": {
    "target": "ES2022",
    "newLine": "lf",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "../templates/assets/ui",
    "rewriteRelativeImportExtensions": true,
    "paths": { "@versytl/scene": ["./vendor/scene/types.ts"] },
    "skipLibCheck": true
  },
  "include": ["*.ts", "vendor/**/*.ts"],
  "exclude": ["vendor/stasis-pages/**"]
}
